# Keep Docker build context small and deterministic

# Python cache and test artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Local configs and secrets
.env
.env.*
!.env.example
.kaggle/
kaggle.json

# VCS, editor, and OS files
.git/
.gitignore
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
tmp/
temp/

# Local uploads and generated data
uploads/
ml/data/raw/*
!ml/data/raw/.gitkeep
ml/data/processed/*.csv

# Build artifacts
dist/
build/
coverage/
node_modules/

# Deployment and docs not needed in the image
deployments/
docs/
scripts/

# SSL and private keys
deployments/docker/nginx/ssl/*
*.pem
*.key

# Keep entrypoint available in the image
!entrypoint.sh